# PostgreSQL: pooled URL for the app, direct URL for migrations. Keep both private.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Optional aliases for URLs copied from the Neon console.
NEON_DATABASE_URL=
NEON_DIRECT_URL=

# Generate a random secret of at least 32 characters before a shared deployment.
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000

# Legacy data import only. The web application no longer reads SQLite.
SQLITE_IMPORT_PATH=./data/cyberwatch.db

# Optional fictional data: `pnpm db:seed --demo` requires both values explicitly.
DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_PASSWORD=

# Report notifications. Only enable in environments that should send real email.
REPORT_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
REPORT_NOTIFICATION_TO=
REPORT_NOTIFICATION_FROM="CyberWatch OAU <onboarding@resend.dev>"
# Protect /api/notifications/dispatch; generate at least 32 random characters.
CRON_SECRET=
