{
  "name": "cyberwatch-oau",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, student-built cyber incident reporting and awareness platform for the OAU community.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-production.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9"
}
